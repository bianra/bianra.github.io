# ===== 数据库 =====
# 开发: SQLite 文件 (相对 backend 目录)
# 生产: Neon PostgreSQL 连接串, 如 postgres://user:pass@host/db?sslmode=require
DATABASE_URL="file:./dev.db"

# ===== 会话密钥 (必填, 强随机字符串; 缺失则启动失败) =====
SESSION_SECRET="change-me-to-a-long-random-string"

# ===== 管理员初始密码 (可选; seed 时使用, 留空则随机生成并打印到控制台) =====
ADMIN_PASSWORD=""

# ===== 前端地址, 用于 CORS 白名单 =====
# 开发: Vite 默认 5173
# 生产: https://bianra.com
CORS_ORIGIN="http://localhost:5173"

# ===== 运行环境 =====
NODE_ENV="development"

# ===== 服务端口 =====
PORT=3000
