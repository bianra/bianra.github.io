# ===== 数据库 (全 PG 方案) =====
# 本地开发: 指向你的 Neon 免费库连接串 (与生产一致, 消除 SQLite/PG 差异)
# 形如: postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require"

# ===== 会话密钥 (必填, 强随机字符串; 缺失则启动失败) =====
SESSION_SECRET="change-me-to-a-long-random-string"

# ===== 管理员初始密码 (可选; seed 时使用, 留空则随机生成并打印到控制台) =====
ADMIN_PASSWORD=""

# ===== 前端地址, 用于 CORS 白名单 =====
# 开发: Vite 默认 5173
# 生产: https://bianra.com (同源部署时前端由后端托管, 无跨域, 可留默认)
CORS_ORIGIN="http://localhost:5173"

# ===== 站点地址 (RSS / robots 用) =====
SITE_URL="https://bianra.com"

# ===== 运行环境 (生产 = production, 此时后端托管 frontend/dist) =====
NODE_ENV="development"

# ===== 服务端口 (Render 自动注入 $PORT) =====
PORT=3000

# ===== 知识 Agent 代理 (可选; 后台「知识 Agent」页用) =====
# 指向同机知识 Agent 服务 (memos-knowledge-system); 留空则后台该页显示"未运行"
AGENT_BASE_URL="http://127.0.0.1:8787/v1"
# 生产必须配置, 与知识 Agent 的 .env 中 AGENT_AUTH_TOKEN 保持一致
AGENT_AUTH_TOKEN=""

# ===== Cookie 安全标志 (可选; 生产默认 true) =====
# 本地 HTTP 调试时设 false, 否则浏览器不保存会话 cookie
COOKIE_SECURE="false"
