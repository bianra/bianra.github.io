// bianra 小屋 v2 数据模型
//
// 统一 PostgreSQL (Neon): 本地开发与生产一致, 消除 SQLite/PG 双套迁移问题
// DATABASE_URL 指向 Neon 连接串; 测试库独立 schema (见 tests/env.js)
//
// 说明: 字段统一用 String;
// 长度限制 (标题 ≤100, 摘要 ≤200, 正文 ≤100KB) 在应用层校验。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 管理员账户 (单管理员)
model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// 个人资料 (单例, id 恒为 1)
model Profile {
  id           Int    @id @default(1) // 单例, 恒为 1
  name         String @default("bianra")
  bio          String @default("") // 关于页长文
  announcement String @default("") // 公告栏 (主页侧栏显示最近 1 条)
  avatarUrl    String @default("") // 头像 URL
  bgUrl        String @default("") // 全站背景图 URL (空 = 默认紫黑渐变)
  artFont      String @default("lobster") // 封页艺术字字体标识
  social       String @default("[]") // JSON 数组 [{label, url}]
}

/// 文章
model Article {
  id        Int      @id @default(autoincrement())
  title     String // ≤100 字 (应用层校验)
  summary   String   @default("") // 摘要 ≤200 字
  content   String // Markdown 正文
  coverUrl  String   @default("") // 封面图 URL
  category  String   @default("diary") // 分类: diary 日记 / study 学习 / code 代码
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([category])
}

/// 上传文件 (存数据库, 避免 Render 免费实例磁盘重置丢图)
model Upload {
  id        Int      @id @default(autoincrement())
  mime      String // 如 image/png
  data      Bytes // 文件二进制
  createdAt DateTime @default(now())
}
